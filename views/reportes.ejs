<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= titulo %></title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <main class="contenedor reportes">
        <header class="encabezado-reportes">
            <div>
                <p class="etiqueta">SUCURSAL ADMINISTRATIVA</p>
                <h1><%= titulo %></h1>
                <p>Consulta y seguimiento de operaciones bancarias.</p>
            </div>
            
            <a class="enlace-secundario" href="/cuentas">
                Apertura de cuentas
            </a>
        </header>

        <section class="panel">
            <h2>Filtrar operaciones</h2>

            <form method="GET" action="/reportes" class="filtros" id="formFiltros">
                <!-- Selector Dinámico de Sucursales -->
                <div>
                    <label for="sucursal">Sucursal</label>
                    <select id="sucursal" name="sucursal">
                        <option value="" <%= !filtros.sucursal ? 'selected' : '' %>>
                            Todas las sucursales
                        </option>
                        <% sucursales.forEach(s => { %>
                            <option value="<%= s %>" <%= filtros.sucursal === s ? 'selected' : '' %>>
                                <%= s %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div>
                    <label for="fechaInicio">Fecha inicial</label>
                    <input
                        id="fechaInicio"
                        type="date"
                        name="fechaInicio"
                        value="<%= filtros.fechaInicio %>"
                    >
                </div>

                <div>
                    <label for="fechaFin">Fecha final</label>
                    <input
                        id="fechaFin"
                        type="date"
                        name="fechaFin"
                        value="<%= filtros.fechaFin %>"
                    >
                </div>

                <div>
                    <label for="tipo">Tipo de operación</label>
                    <select id="tipo" name="tipo">
                        <option value="" <%= filtros.tipo === '' ? 'selected' : '' %>>Todos los tipos</option>
                        <option value="deposito" <%= filtros.tipo === 'deposito' ? 'selected' : '' %>>Depósitos</option>
                        <option value="retiro" <%= filtros.tipo === 'retiro' ? 'selected' : '' %>>Retiros</option>
                        <option value="transferencia" <%= filtros.tipo === 'transferencia' ? 'selected' : '' %>>Transferencias</option>
                    </select>
                </div>
                
                <div>
                    <label for="cuenta">Número de cuenta</label>
                    <input
                        id="cuenta"
                        type="text"
                        name="cuenta"
                        placeholder="Ingresa el número de cuenta"
                        value="<%= filtros.cuenta || '' %>"
                    >
                </div>

                <button type="submit">Aplicar filtros</button>
            </form>
        </section>

        <section class="resumen">
            <article class="tarjeta-resumen">
                <span>Operaciones encontradas</span>
                <strong><%= transacciones.length %></strong>
            </article>

            <article class="tarjeta-resumen">
                <span>Importe total</span>
                <strong>
                    <%= transacciones.reduce((total, t) => total + (Number(t.amount) || 0), 0).toLocaleString('es-MX', {
                        style: 'currency',
                        currency: 'MXN'
                    }) %>
                </strong>
                <small>Suma de las operaciones mostradas</small>
            </article>

            <article class="tarjeta-resumen">
                <span>Estado de consulta</span>
                <strong><%= error ? 'Con error' : 'Conectado' %></strong>
                <small>
                    <%= error ? 'No fue posible completar la consulta' : 'Datos recibidos del Banco Central' %>
                </small>
            </article>
        </section>

        <% if (error) { %>
            <div class="aviso aviso-error" role="alert">
                <%= error %>
            </div>
        <% } %>

        <% if (pendiente) { %>
            <div class="aviso" role="status">
                <strong>Consulta central pendiente</strong>
                <p>
                    Los filtros están preparados, pero todavía no se han
                    consultado transacciones reales. La información se
                    conectará cuando esté disponible la API del Banco Central.
                </p>
            </div>
        <% } %>

        <section class="panel">
            <h2>Historial de transacciones</h2>

            <div class="tabla-contenedor">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Cuenta origen</th>
                            <th>Cuenta destino</th>
                            <th>Importe</th>
                            <th>Sucursal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (transacciones.length === 0) { %>
                            <tr>
                                <td colspan="6" class="sin-resultados">
                                    No hay datos disponibles para mostrar.
                                </td>
                            </tr>
                        <% } else { %>
                            <% transacciones.forEach((t) => { %>
                                <tr>
                                    <td><%= t.created_at %></td>
                                    <td><%= t.type %></td>
                                    <td><%= t.origin_account ?? '—' %></td>
                                    <td><%= t.destination_account ?? '—' %></td>
                                    <td><%= t.amount %></td>
                                    <td><%= t.node_name || t.branch || t.sucursal || '—' %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const selector = document.getElementById('sucursal');
        const form = document.getElementById('formFiltros');
        const clave = 'sucursalSeleccionada';

        if (!selector) return;

        const urlParams = new URLSearchParams(window.location.search);
        
        // Recuperar persistencia inicial desde localStorage si la URL no la trae
        if (!urlParams.has('sucursal')) {
            const guardada = localStorage.getItem(clave);
            if (guardada && [...selector.options].some(op => op.value === guardada)) {
                selector.value = guardada;
            }
        }

        // Actualizar almacenamiento y enviar formulario al cambiar la sucursal
        selector.addEventListener('change', () => {
            localStorage.setItem(clave, selector.value);
            form.submit();
        });
    });
    </script>
</body>
</html>